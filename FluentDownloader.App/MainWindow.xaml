<ui:FluentWindow
    x:Class="FluentDownloader.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="FluentDownloader"
    Width="1280"
    Height="800"
    MinWidth="980"
    MinHeight="620"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Default"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <ui:NavigationView
            x:Name="RootNavigation"
            PaneDisplayMode="Left"
            OpenPaneLength="224"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            FrameMargin="0"
            TitleBar="{Binding ElementName=RootTitleBar, Mode=OneWay}"
            Transition="FadeInWithSlide">
            <ui:NavigationView.MenuItems>
                <!--  由代码后台按“首页/任务 + 各模块页面”顺序填充  -->
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <!--  设置项在代码后台追加  -->
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <ui:TitleBar
            x:Name="RootTitleBar"
            Title="FluentDownloader"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="True" />

        <!--  自定义 Toast 通知（右下角）：WPF-UI 4.3.0 的 Snackbar 彩色外观存在空文本渲染缺陷，弃用  -->
        <Border
            x:Name="ToastBorder"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,24,28"
            MaxWidth="420"
            MinWidth="280"
            CornerRadius="8"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            Padding="14,12"
            Opacity="0"
            Visibility="Collapsed"
            IsHitTestVisible="True"
            MouseLeftButtonDown="OnToastClick">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.35" Color="#000000" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTransform" Y="0" />
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="4" Margin="0,0,12,0" CornerRadius="2"
                        Background="{DynamicResource SystemFillColorSuccessBrush}"
                        x:Name="ToastAccentBar" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="ToastTitle" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ToastMessage" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                               MaxHeight="64"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
