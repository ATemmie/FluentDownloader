<Page
    x:Class="FluentDownloader.App.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:services="clr-namespace:FluentDownloader.App.Services"
    xmlns:shared="clr-namespace:FluentDownloader.Shared.Services;assembly=FluentDownloader.Shared"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="OnLoaded">

    <Page.Resources>
        <services:EnumEqualsConverter x:Key="EnumEquals" />
        <services:BytesPerSecondToMbConverter x:Key="BytesToMb" />
    </Page.Resources>

    <ScrollViewer shared:FrameHeightConstraint.Enable="True" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" Margin="44,28,44,32" HorizontalAlignment="Left">

            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />

            <!--  外观  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="外观" />
            <ui:Card>
                <StackPanel>
                    <TextBlock Text="主题模式" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,10"
                               Text="切换立即生效并自动保存" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="浅色" Margin="0,0,24,0"
                                     IsChecked="{Binding Settings.Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Light, Mode=TwoWay}"
                                     Checked="OnThemeChanged" />
                        <RadioButton Content="深色" Margin="0,0,24,0"
                                     IsChecked="{Binding Settings.Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Dark, Mode=TwoWay}"
                                     Checked="OnThemeChanged" />
                        <RadioButton Content="跟随系统"
                                     IsChecked="{Binding Settings.Theme, Converter={StaticResource EnumEquals}, ConverterParameter=System, Mode=TwoWay}"
                                     Checked="OnThemeChanged" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!--  下载  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="下载" />
            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="下载目录" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,8"
                                   Text="{Binding Settings.DownloadDirectory}" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="更改…" VerticalAlignment="Center"
                               Icon="{ui:SymbolIcon Folder24}"
                               Command="{Binding BrowseDownloadDirectoryCommand}" />
                </Grid>
            </ui:Card>
            <UniformGrid Columns="2" Margin="0,10,0,0">
                <ui:Card Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="同时下载任务数" FontWeight="SemiBold" />
                        <ui:NumberBox Margin="0,8,0,0" Width="160" HorizontalAlignment="Left"
                                      Minimum="1" Maximum="10" SpinButtonPlacementMode="Compact"
                                      Value="{Binding Settings.MaxConcurrentDownloads}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card>
                    <StackPanel>
                        <TextBlock Text="HTTP 每任务连接数" FontWeight="SemiBold" />
                        <ui:NumberBox Margin="0,8,0,0" Width="160" HorizontalAlignment="Left"
                                      Minimum="1" Maximum="32" SpinButtonPlacementMode="Compact"
                                      Value="{Binding Settings.HttpConnectionsPerTask}" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>
            <ui:Card Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="HTTP 全局限速 (MB/s)" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,8"
                               Text="0 表示不限速" />
                    <ui:NumberBox Width="160" HorizontalAlignment="Left"
                                  Minimum="0" Maximum="4096" SpinButtonPlacementMode="Compact"
                                  Value="{Binding Settings.HttpSpeedLimitBytesPerSecond, Converter={StaticResource BytesToMb}}" />
                </StackPanel>
            </ui:Card>

            <!--  BitTorrent  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="BitTorrent" />
            <ui:Card>
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="监听端口" FontWeight="SemiBold" />
                        <ui:NumberBox Margin="0,8,0,0" Width="160" HorizontalAlignment="Left"
                                      Minimum="1024" Maximum="65535" SpinButtonPlacementMode="Compact"
                                      Value="{Binding Settings.TorrentListenPort}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="上传限速 (MB/s)" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,8" Text="0 表示不限速" />
                        <ui:NumberBox Width="160" HorizontalAlignment="Left"
                                      Minimum="0" Maximum="4096" SpinButtonPlacementMode="Compact"
                                      Value="{Binding Settings.TorrentMaxUploadSpeedBytesPerSecond, Converter={StaticResource BytesToMb}}" />
                    </StackPanel>
                </UniformGrid>
            </ui:Card>

            <!--  数据  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="数据" />
            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="应用数据目录" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0"
                                   Text="任务记录、cookies、引擎二进制（yt-dlp / ffmpeg）保存在这里" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="打开" VerticalAlignment="Center"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Command="{Binding OpenDataDirectoryCommand}" />
                </Grid>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
