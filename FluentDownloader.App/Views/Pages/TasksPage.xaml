<Page
    x:Class="FluentDownloader.App.Views.Pages.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:services="clr-namespace:FluentDownloader.App.Services"
    xmlns:contracts="clr-namespace:FluentDownloader.Contracts;assembly=FluentDownloader.Contracts"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="OnLoaded">

    <Page.Resources>
        <services:BytesTextConverter x:Key="BytesText" />
        <services:SpeedTextConverter x:Key="SpeedText" />
        <services:BytesProgressTextConverter x:Key="BytesProgress" />
        <services:EtaTextConverter x:Key="EtaText" />
        <services:StatusVisibilityConverter x:Key="StatusVisible" />
        <services:CountToVisibilityConverter x:Key="CountToVisibility" />
        <services:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisible" />

        <!--  任务卡片模板  -->
        <DataTemplate x:Key="TaskCardTemplate" DataType="{x:Type contracts:DownloadTask}">
            <ui:Card Margin="0,0,0,10">
                <ui:Card.RenderTransform>
                    <TranslateTransform />
                </ui:Card.RenderTransform>
                <ui:Card.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource CardEnterAnimation}" />
                    </EventTrigger>
                </ui:Card.Triggers>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  行1：标题 + 引擎 + 状态  -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Url}" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock FontSize="11" Padding="6,1"
                                           Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding EngineDisplayName}" />
                                <TextBlock FontSize="11" Padding="6,1" Margin="6,0,0,0"
                                           Text="{Binding QualityLabel}"
                                           Visibility="{Binding QualityLabel, Converter={StaticResource NotEmptyToVisible}}" />
                                <TextBlock FontSize="11" Padding="6,1" Margin="6,0,0,0" Text="{Binding Status}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <!--  暂停  -->
                            <ui:Button Icon="{ui:SymbolIcon Pause24}" ToolTip="暂停" Margin="4,0,0,0"
                                       Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding}"
                                       Visibility="{Binding Status, Converter={StaticResource StatusVisible}, ConverterParameter='Pending,Preparing,Downloading'}" />
                            <!--  继续  -->
                            <ui:Button Icon="{ui:SymbolIcon Play24}" ToolTip="继续" Margin="4,0,0,0"
                                       Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding}"
                                       Visibility="{Binding Status, Converter={StaticResource StatusVisible}, ConverterParameter='Paused,Failed,Cancelled'}" />
                            <!--  取消  -->
                            <ui:Button Icon="{ui:SymbolIcon Stop24}" ToolTip="取消" Margin="4,0,0,0"
                                       Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding}"
                                       Visibility="{Binding Status, Converter={StaticResource StatusVisible}, ConverterParameter='Pending,Preparing,Downloading,Paused'}" />
                            <!--  打开文件夹  -->
                            <ui:Button Icon="{ui:SymbolIcon Folder24}" ToolTip="打开文件夹" Margin="4,0,0,0"
                                       Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding}"
                                       Visibility="{Binding Status, Converter={StaticResource StatusVisible}, ConverterParameter='Completed'}" />
                            <!--  移除  -->
                            <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="移除任务" Margin="4,0,0,0"
                                       Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>

                    <!--  行2：进度条  -->
                    <ProgressBar
                        Grid.Row="1"
                        Height="6"
                        Margin="0,12,0,0"
                        Maximum="100"
                        Value="{Binding ProgressPercent, Mode=OneWay}"
                        IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />

                    <!--  行3：数据与错误  -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource MutedText}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource BytesProgress}">
                                    <Binding Path="ReceivedBytes" Mode="OneWay" />
                                    <Binding Path="TotalBytes" Mode="OneWay" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,12,0"
                                       Text="{Binding SpeedBytesPerSecond, Converter={StaticResource SpeedText}}" />
                            <TextBlock Style="{StaticResource MutedText}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource EtaText}" StringFormat="剩余 {0}">
                                        <Binding Path="ReceivedBytes" Mode="OneWay" />
                                        <Binding Path="TotalBytes" Mode="OneWay" />
                                        <Binding Path="SpeedBytesPerSecond" Mode="OneWay" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="3" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Text="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVisible}}" />
                </Grid>
            </ui:Card>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="44,28,44,8">
            <TextBlock Text="下载任务" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"
                       Text="{Binding Tasks.Count, StringFormat=共 {0} 个任务}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="44,12,44,32">
                <TextBlock Margin="0,24,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding Tasks.Count, Converter={StaticResource CountToVisibility}}"
                           Text="暂无任务 —— 回首页粘贴链接，或在「网页嗅探」里点选下载" />
                <ItemsControl ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource TaskCardTemplate}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
