<Page
    x:Class="FluentDownloader.App.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:services="clr-namespace:FluentDownloader.App.Services"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="OnLoaded">

    <Page.Resources>
        <services:BytesTextConverter x:Key="BytesText" />
        <services:SpeedTextConverter x:Key="SpeedText" />
        <services:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisible" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="940" Margin="44,28,44,32" HorizontalAlignment="Left">

            <TextBlock Text="FluentDownloader" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Fluent 风格多功能下载器 · 模块化设计" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!--  添加下载  -->
            <Border Style="{StaticResource HeroCard}" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="添加下载" FontSize="16" FontWeight="SemiBold" />
                    <DockPanel Margin="0,14,0,0">
                        <ui:Button
                            DockPanel.Dock="Right"
                            Margin="12,0,0,0"
                            Padding="18,0"
                            Height="40"
                            Content="添加下载"
                            Appearance="Primary"
                            Icon="{ui:SymbolIcon Add24}"
                            Command="{Binding AddCommand}" />
                        <ui:TextBox
                            Height="40"
                            VerticalAlignment="Center"
                            PlaceholderText="粘贴链接：直链 / 视频页面 / m3u8 / 磁力链…"
                            Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}"
                            KeyDown="OnUrlKeyDown" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
                               Text="自动识别链接类型并路由到对应模块 · 浏览器模块支持边看边下" />
                    <TextBlock Text="{Binding Message}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Message, Converter={StaticResource NotEmptyToVisible}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!--  统计卡片  -->
            <UniformGrid Columns="3" Margin="0,16,0,0">
                <ui:Card Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" Text="全局速度" />
                        <TextBlock FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"
                                   Text="{Binding GlobalSpeed, Converter={StaticResource SpeedText}}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" Text="进行中任务" />
                        <TextBlock FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"
                                   Text="{Binding ActiveCount}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card>
                    <StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" Text="已完成" />
                        <TextBlock FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"
                                   Text="{Binding CompletedCount}" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <!--  引导  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="开始使用" />
            <UniformGrid Columns="2">
                <ui:Card Margin="0,0,8,8">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Globe24" FontSize="22" />
                        <TextBlock Text="边浏览边下载" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,0"
                                   Text="打开侧栏「网页嗅探」，输入网址浏览页面，右侧会自动列出可下载的视频、音频与文件，点击即下。" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="0,0,0,8">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="22" />
                        <TextBlock Text="多线程直链下载" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,0"
                                   Text="大文件自动分 8 段并发下载，支持断点续传与限速；粘贴链接即可自动识别。" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

        </StackPanel>
    </ScrollViewer>
</Page>
