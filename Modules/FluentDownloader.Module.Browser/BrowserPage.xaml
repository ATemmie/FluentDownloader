<Page
    x:Class="FluentDownloader.Module.Browser.BrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:FluentDownloader.Module.Browser"
                    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Page.Resources>
        <local:BytesTextConverter x:Key="BytesText" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  工具栏  -->
        <Border Grid.Row="0" Padding="10,8" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}" ToolTip="后退" Margin="0,0,4,0" Click="OnBack" />
                    <ui:Button Icon="{ui:SymbolIcon ArrowRight24}" ToolTip="前进" Margin="0,0,4,0" Click="OnForward" />
                    <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="刷新" Margin="0,0,4,0" Click="OnReload" />
                </StackPanel>
                <ui:Button DockPanel.Dock="Right" Content="同步 Cookies" ToolTip="把当前网站的登录态导出给下载引擎（B站高清等场景）"
                           Margin="8,0,0,0" Icon="{ui:SymbolIcon Key24}" Click="OnExportCookies" />
                <ui:ToggleSwitch DockPanel.Dock="Right" Content="点选模式" Margin="0,0,12,0"
                                 Click="OnPickerToggle" x:Name="PickerToggle" />
                <ui:TextBox x:Name="AddressBox" Height="36" VerticalAlignment="Center" Margin="8,0"
                            PlaceholderText="输入网址，回车打开（例：bilibili.com）"
                            KeyDown="OnAddressKeyDown" />
            </DockPanel>
        </Border>

        <!--  网页 + 嗅探面板  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="320" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="White">
                <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="White" />
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

            <Border Grid.Column="2" Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="12,10">
                        <TextBlock Text="可下载资源" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="清空列表" Click="OnClearResources" />
                        </StackPanel>
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Margin="12,6" TextWrapping="Wrap"
                               Style="{StaticResource MutedText}" Text="打开网页后自动嗅探；点击资源卡片即加入下载" />
                    <ListBox x:Name="ResourceList" Margin="6,0" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,3" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="Document24" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Video">
                                                            <Setter Property="Symbol" Value="Video24" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Audio">
                                                            <Setter Property="Symbol" Value="Speaker224" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Playlist">
                                                            <Setter Property="Symbol" Value="VideoPlayPause24" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Image">
                                                            <Setter Property="Symbol" Value="Image24" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Url}" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <Run Text="{Binding MimeType, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding SizeBytes, Converter={StaticResource BytesText}, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon ArrowDownload24}"
                                                   ToolTip="加入下载" VerticalAlignment="Center"
                                                   Tag="{Binding}" Click="OnDownloadResource" />
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="PickerHint" Margin="12,4" Visibility="Collapsed"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   Text="点选模式已开启：鼠标悬停高亮页面元素，点击即抓取其资源地址（Esc 退出）" />
    </Grid>
</Page>
