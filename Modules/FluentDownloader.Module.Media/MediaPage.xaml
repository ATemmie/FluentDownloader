<Page
    x:Class="FluentDownloader.Module.Media.MediaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:FluentDownloader.Module.Media"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="OnLoaded">

    <Page.Resources>
        <local:UrlToImageConverter x:Key="UrlToImage" />
        <local:NotEmptyToVisibleConverter x:Key="NotEmptyToVisible" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880" Margin="44,28,44,32" HorizontalAlignment="Left">

            <TextBlock Text="视频 / 音乐解析" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"
                       Text="支持 YouTube、B站、抖音、快手、网易云、QQ音乐(免费曲库)、SoundCloud 等上千个站点" />

            <!--  输入  -->
            <Border Style="{StaticResource HeroCard}" Margin="0,20,0,0">
                <StackPanel>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="18,0" Height="40"
                                   Content="{Binding IsParsing, Converter={StaticResource ParsingText}}"
                                   Appearance="Primary" IsEnabled="{Binding IsParsing, Converter={StaticResource Inverse}}"
                                   Command="{Binding ParseCommand}" />
                        <ui:TextBox Height="40" VerticalAlignment="Center"
                                    PlaceholderText="粘贴视频/音乐页面链接，例如 https://www.bilibili.com/video/BV…"
                                    Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
                               Text="需要高清画质时，先在「网页嗅探」里登录并同步 Cookies" />
                    <TextBlock Text="{Binding Status}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Status, Converter={StaticResource NotEmptyToVisible}}"
                               Foreground="{Binding IsError, Converter={StaticResource ErrorBrush}}" />
                </StackPanel>
            </Border>

            <!--  解析结果  -->
            <ui:Card Margin="0,16,0,0" Visibility="{Binding Current, Converter={StaticResource NullToCollapsed}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="168" Height="94" CornerRadius="8"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Image Source="{Binding Current.Thumbnail, Converter={StaticResource UrlToImage}}"
                                   Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Current.Title}" FontSize="16" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Current.Uploader}" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="选择清晰度 / 格式" FontWeight="SemiBold" Margin="0,16,0,8" />
                    <ComboBox ItemsSource="{Binding Current.Formats}"
                              SelectedItem="{Binding SelectedFormat}"
                              MinWidth="320" HorizontalAlignment="Left" />
                    <ui:Button Content="添加下载任务" Appearance="Primary" Margin="0,16,0,0" Padding="18,0"
                               Icon="{ui:SymbolIcon Add24}"
                               Command="{Binding AddDownloadCommand}" />
                </StackPanel>
            </ui:Card>

            <!--  引擎状态  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="下载引擎" />
            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding EngineStatus}" />
                        <TextBlock Text="{Binding FfmpegStatus}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="更新 yt-dlp" VerticalAlignment="Center"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Command="{Binding UpdateEngineCommand}" />
                </Grid>
            </ui:Card>

            <!--  合规说明  -->
            <ui:Card Margin="0,0,0,8" Padding="16">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="说明" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="本工具仅下载公开可访问的内容。VIP / 付费 / DRM 加密内容不受支持；请遵守各平台服务条款，下载内容仅供个人学习使用。" />
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
