<Page
    x:Class="FluentDownloader.Module.Torrent.TorrentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:FluentDownloader.Module.Torrent"
         xmlns:shared="clr-namespace:FluentDownloader.Shared.Services;assembly=FluentDownloader.Shared"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="OnLoaded">

    <Page.Resources>
        <local:NotEmptyToVisibleConverter x:Key="NotEmptyToVisible" />
    </Page.Resources>

    <ScrollViewer shared:FrameHeightConstraint.Enable="True" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880" Margin="44,28,44,32" HorizontalAlignment="Left">

            <TextBlock Text="BitTorrent" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"
                       Text="磁力链与种子文件下载 · DHT 内置 · 完成后自动停止做种" />

            <Border Style="{StaticResource HeroCard}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="添加 BT 任务" FontWeight="SemiBold" />
                    <DockPanel Margin="0,14,0,0">
                        <ui:Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="18,0" Height="40"
                                   Content="添加下载" Appearance="Primary"
                                   Icon="{ui:SymbolIcon Add24}"
                                   Command="{Binding AddMagnetCommand}" />
                        <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Height="40"
                                   Content="选择种子文件…" Icon="{ui:SymbolIcon Document24}"
                                   Command="{Binding BrowseTorrentCommand}" />
                        <ui:TextBox Height="40" VerticalAlignment="Center"
                                    PlaceholderText="粘贴磁力链 magnet:?xt=… 或种子文件路径"
                                    Text="{Binding MagnetInput, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Status}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Status, Converter={StaticResource NotEmptyToVisible}}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                </StackPanel>
            </Border>

            <ui:Card Margin="0,16,0,0" Padding="16">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="使用提示" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="磁力链需要从 DHT 网络获取元数据，冷门资源可能较慢；完成任务后为保护硬盘与带宽默认停止做种。请仅用于合法内容的分发与下载。" />
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
